#!/usr/bin/env python3
"""bh: the Boathouse command line. Standard library only, so it installs by copy.

  bh signup "<workspace name>" <email> [--api https://api.boathousecloud.com]   new workspace, no key needed
  bh claim <code>                   the one-time code from your account page: fetches your key and logs in
  bh login <https://api.boathousecloud.com> <project-key>
  bh whoami | bh logout <workspace>   your key is you, in every workspace you belong to; aim a command with --ws <workspace> or name a tool <workspace>/<tool>
  bh mail status | set --host ... --user ... | test   (host owner) the mailbox Boat House sends share emails from
  bh deploy [--name "Finance"] [--note "why"] [--slug finance]     in the tool's folder
  bh ls | bh status <tool> | bh logs <tool> [--tail N] [--since 1h]
  bh rollback <tool> [--to N] | bh restart <tool> | bh releases <tool>
  bh share <tool> <email> --tier viewer|editor|admin [--label x] | bh unshare <tool> <email>   prints an invite link for new people
  bh pull <tool> [dir]              fetch the live source (admins); bh deploy pushes it back, refusing a stale base
  bh secrets ls <tool> | bh secrets set <tool> NAME [value | -] | bh secrets rm <tool> NAME
  bh users [add <email> --role member|owner|guest] [rm <email>] [invite <email>]
  bh domain ls | check <name> | buy <name> [--yes] [--to <tool>] | attach <name> [--to <tool>] | point <name> --to <tool> | dns <name> | repoint <name> | primary <name> | detach <name> | free
  bh billing | card | topup <dollars> [--yes] | autorefill <dollars> [--cap dollars] | grant <ws> <dollars> [--memo] | stripe-keys | meter
  bh prices
  bh registrar status | connect [--sandbox] | wait | keys
  bh keys [create --name x [--for email]] [revoke <id>]
  bh rm <tool> [--purge] | bh audit | bh whoami
  bh export [<tool>] [--dir .] [--all]   one .tar.gz per tool: source/, database.sql, data/, README.txt
  bh restore <tool> [--from YYYY-MM-DD] [--yes]   database and files back from a nightly backup; shows the plan first
  bh update | bh skill              re-download bh from the platform; install/refresh the Claude Code skill
"""
