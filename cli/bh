def cmd_registrar(a):
    if a.action == "status":
        out(call("GET", "/api/registrar"))
    elif a.action == "connect":
        r = call("POST", "/api/registrar/connect", body={"sandbox": a.sandbox})
        if r.get("state") == "connected":
            print("connected to the registrar SANDBOX (fake money, real catalog)")
            return
        print("Open this link, sign in to (or create) the registrar account, and approve. Nothing to copy.")
        print(f"  {r['auth_url']}")
        print(f"valid until {r.get('expires')} (30 minutes). Then: bh registrar wait")
    elif a.action == "wait":
        deadline = time.time() + 31 * 60
        while time.time() < deadline:
            try:
                r = call("POST", "/api/registrar/connect/finish", body={})
            except SystemExit:
                die("the approval link expired or was denied; run bh registrar connect for a fresh one")
            if r.get("state") == "connected":
                print("registrar connected" + (" (sandbox)" if r.get("sandbox") else ""))
                return
            time.sleep(20)
        die("the approval link expired; run bh registrar connect again")
    elif a.action == "keys":
        key = os.environ.get("PORKBUN_API_KEY") or __import__("getpass").getpass("api key: ")
        sec = os.environ.get("PORKBUN_SECRET_KEY") or __import__("getpass").getpass("secret key: ")
        out(call("PUT", "/api/registrar/keys", body={"apikey": key, "secret": sec}))


