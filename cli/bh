def cmd_deploy(a):
    t0 = time.time()
    meta0 = Path(a.path or ".").resolve() / "boathouse.json"
    if meta0.exists() and not ACTIVE["ws"]:
        try:
            w0 = json.loads(meta0.read_text()).get("workspace")
            ACTIVE["ws"] = w0 if w0 and w0 != "*" else None
        except ValueError:
            pass
    root = Path(a.path or ".").resolve()
    slug = a.slug or guess_slug(root)
    meta = root / "boathouse.json"
    m = json.loads(meta.read_text()) if meta.exists() else {}
    name = a.name or m.get("name")
    base = None if a.force else m.get("base")
    chk = call("GET", f"/api/billing/deploy-check?tool={urllib.parse.quote(slug)}")     # before packing or uploading anything
    if not chk.get("ok", True):
        die(chk["message"] + f"  (HTTP {chk.get('code') or 402})")
    blob = pack(root)
    print(f"deploying {slug} ({len(blob) // 1024} KB" + (f", based on #{base}" if base else "") + ") …", flush=True)
    r = call("POST", f"/api/tools/{slug}/deploys", body={"note": a.note, "name": name, "base": base}, files={"context": (f"{slug}.tar.gz", blob)})
    t = call("GET", f"/api/tools/{slug}")
    who = "anyone on the internet (public)" if t.get("public") else ("workspace members" if t["default_access"] == "members" else "listed people only")
    print(f"live: {r['url']}  (release #{r['release']})")
    others = max(0, len(t["grants"]) - 1)   # the deployer holds a grant too; count the other people
    print(f"visible to: {who}" + (f", shared with {others} more" if others else "") + f"   ({time.time() - t0:.0f}s)")
    m.update({"slug": slug, "name": name or m.get("name") or slug, "base": r["release"]})
    meta.write_text(json.dumps(m, indent=2) + "\n")


def cmd_pull(a):
    dest = Path(a.dir or getattr(a, "dir2", None) or a.tool).resolve()
    q = f"?release={a.release}" if a.release else ""
    cfg = load_cfg()
    req = urllib.request.Request(cfg["api"] + f"/api/tools/{a.tool}/source{q}", headers=auth_headers(cfg))
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            blob, seq = r.read(), r.headers.get("X-Boathouse-Release")
    except urllib.error.HTTPError as e:
        payload = e.read().decode(errors="replace")
        try:
            detail = json.loads(payload).get("detail", payload)
        except ValueError:
            detail = payload
        die(f"{detail}  (HTTP {e.code})")
    if dest.exists() and any(dest.iterdir()) and not a.force:
        die(f"{dest} is not empty; pick another folder or add --force to overwrite files")
    dest.mkdir(parents=True, exist_ok=True)
    with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as tf:
        for m in tf.getmembers():
            if m.name.startswith(("/", "..")) or "/../" in m.name:
                die(f"refusing suspicious path in archive: {m.name}")
        tf.extractall(dest)
    meta = dest / "boathouse.json"
    m = json.loads(meta.read_text()) if meta.exists() else {"slug": a.tool, "name": a.tool}
    m["base"] = int(seq) if seq else m.get("base")
    m["workspace"] = workspace_name(cfg) or m.get("workspace")      # so a later `bh deploy` in this folder goes to the right workspace
    meta.write_text(json.dumps(m, indent=2) + "\n")
    print(f"pulled {a.tool} release #{seq} into {dest}. Edit, then `bh deploy` there.")


