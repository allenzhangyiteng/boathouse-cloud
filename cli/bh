def cmd_billing(a):
    if a.action == "status":
        b = call("GET", "/api/billing")
        state = "PAUSED" if b["paused"] else "active"
        print(f"workspace {b['workspace']}: balance {_money(b['balance_cents'])} ({state}); {b['running_tools']} running tool(s) burn {_money(b['burn_cents_per_day'])}/day"
              + (f", about {b['days_left']} days left" if b["days_left"] is not None else ""))
        print("card on file: " + ("yes" if b["card_on_file"] else "no (bh billing card)") + (f"; auto-refill {_money(b['autorefill_cents'])}" + (f" up to {_money(b['autorefill_cap_cents'])}/month" if b["autorefill_cap_cents"] else "") if b["autorefill_cents"] else ""))
        if b.get("plan"):
            print(f"organization plan: {_money(b['organization_month_cents'])}/month, up to {b['included_tools']} lightweight tools")
            usage = b.get("organization_usage") or {}
            if usage.get("enforced"):
                print(f"shared app memory: {usage['memory_bytes']/1024**2:.1f} of {usage['memory_limit_bytes']/1024**2:g} MB; compute: {usage['cpu_limit_cores']:g} CPU core")
            if usage.get("message"): print(usage["message"])
        if b["ledger"]:
            print(f"{'WHEN':<18}{'KIND':<8}{'AMOUNT':>10}{'BALANCE':>10}  MEMO")
            for l in b["ledger"]:
                print(f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(l['ts'])):<18}{l['kind']:<8}{_money(l['amount_cents']):>10}{_money(l['balance_after']):>10}  {l['memo'] or ''}")
    elif a.action == "card":
        r = call("POST", "/api/billing/card", body={})
        print("Open this once and enter the card. That is the only billing step that needs a browser.")
        print(f"  {r['url']}")
    elif a.action == "topup":
        cents = _dollars(a.arg1)
        # Persist the quoted operation before submission: a lost HTTP response or
        # a new CLI process must retry the same payment, never invent another.
        cfg = load_cfg()
        marker = hashlib.sha256(f"{cfg['api']}|{workspace_name(cfg)}|{cents}".encode()).hexdigest()
        pending_path = CONFIG.parent / f"payment-{marker}.json"
        pending = json.loads(pending_path.read_text()) if pending_path.exists() else {}
        q = call("POST", "/api/billing/topup", body={"cents": cents, "operation_id": pending.get("operation_id")})
        if q["payment_status"] == "failed" or (q["payment_status"] == "quoted" and q["expires"] < time.time()):
            q = call("POST", "/api/billing/topup", body={"cents": cents})
        pending_path.parent.mkdir(parents=True, exist_ok=True)
        temporary = pending_path.with_suffix(".tmp-" + uuid.uuid4().hex)
        temporary.write_text(json.dumps({"operation_id": q["operation_id"]}))
        temporary.chmod(0o600)
        temporary.replace(pending_path)
        print(q["message"] + f" Balance after: {_money(q['balance_after_cents'])}.")
        if not a.yes:
            print("dry run only. Re-run with --yes to get the secure payment link."); return
        r = call("POST", "/api/billing/topup", body={"cents": cents, "confirm": True, "operation_id": q["operation_id"]}, timeout=120)
        if r.get("requires_checkout"):
            print(r["message"]); print(r.get("checkout_url") or "Open your account to check this payment."); return
        print(f"charged {_money(r['cents'])}; balance now {_money(r['balance_cents'])}" + (" (workspace resumed)" if r.get("resumed") else ""))
        pending_path.unlink(missing_ok=True)
    elif a.action == "autorefill":
        cents = _dollars(a.arg1) if a.arg1 else 0
        r = call("POST", "/api/billing/autorefill", body={"cents": cents, "cap_cents": _dollars(a.cap) if a.cap else cents})
        print(r["note"])
    elif a.action == "grant":
        if not a.arg1 or not a.arg2:
            die("usage: bh billing grant <workspace> <dollars> [--memo text]")
        r = call("POST", "/api/billing/grant", body={"workspace": a.arg1, "cents": _dollars(a.arg2), "memo": a.memo})
        print(f"{r['workspace']} balance now {_money(r['balance_cents'])}")
    elif a.action == "stripe-keys":
        sec = os.environ.get("STRIPE_SECRET_KEY") or __import__("getpass").getpass("stripe secret key: ")
        wh = os.environ.get("STRIPE_WEBHOOK_SECRET") or __import__("getpass").getpass("stripe webhook signing secret: ")
        r = call("PUT", "/api/billing/stripe-keys", body={"secret": sec, "webhook_secret": wh})
        print(f"stripe connected; point the webhook at {r['webhook_url']} (events checkout.session.completed and payment_intent.succeeded)")
    elif a.action == "meter":
        r = call("POST", "/api/billing/meter", body={})
        for l in r["lines"]:
            print(f"{l['workspace']:<12}{l['tool']:<16}{_money(l['cents']):>8}  {l['gb']} GB")
        if not r["lines"]:
            print("nothing to charge (already metered today, or nothing running)")


