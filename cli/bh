def _config_candidates():
    """Where the login lives: the XDG place first, then a plain dotfolder for machines where ~/.config is not writable."""
    xdg = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "boathouse" / "config.json"
    return [xdg, Path.home() / ".boathouse" / "config.json"]


CONFIG = (Path(os.environ["BH_CONFIG"]) if os.environ.get("BH_CONFIG")
          else next((c for c in _config_candidates() if c.exists()), _config_candidates()[0]))


def save_cfg(data: dict) -> Path:
    global CONFIG
    candidates = [CONFIG] if os.environ.get("BH_CONFIG") else list(dict.fromkeys([CONFIG] + _config_candidates()))
    for c in candidates:
        try:
            c.parent.mkdir(parents=True, exist_ok=True)
            c.write_text(json.dumps(data))
            c.chmod(0o600)
            CONFIG = c
            return c
        except PermissionError:
            continue
    die("could not write the login file: neither ~/.config/boathouse nor ~/.boathouse is writable")
ALWAYS_EXCLUDE = {".git", "node_modules", "__pycache__", ".venv", "venv", ".env", ".DS_Store", ".mypy_cache", ".pytest_cache"}


ACTIVE = {"ws": None}   # the workspace a command is aimed at: --ws, a <workspace>/<tool> name, or boathouse.json


def read_config() -> dict:
    """{"logins": [{api, key, workspace, email, domain}, ...], "default": <workspace>}; reads the old one-login file too."""
    if not CONFIG.exists():
        return {"logins": [], "default": None}
    raw = json.loads(CONFIG.read_text())
    if "logins" not in raw:
        raw = {"logins": [{"api": raw["api"], "key": raw["key"], "workspace": raw.get("workspace"), "email": raw.get("email"), "domain": raw.get("domain")}],
               "default": raw.get("workspace")}
    if any(not l.get("workspace") for l in raw["logins"]) and not os.environ.get("BH_KEY"):
        raw = _fill_workspaces(raw)      # an older file: learn the workspace names once, keep them
    return raw


def _fill_workspaces(cfg: dict) -> dict:
    """An older login file has no workspace name; ask the API once and keep it."""
    for l in cfg["logins"]:
        if l.get("workspace"):
            continue
        os.environ["BH_API"], os.environ["BH_KEY"] = l["api"], l["key"]
        try:
            me = call("GET", "/api/whoami")
            l.update(workspace=me["workspace"], email=me["email"], domain=me["domain"])
        except SystemExit:
            pass
        finally:
            del os.environ["BH_API"], os.environ["BH_KEY"]
    if not cfg.get("default"):
        cfg["default"] = next((l["workspace"] for l in cfg["logins"] if l.get("workspace")), None)
    save_cfg(cfg)
    return cfg


def save_login(login: dict) -> Path:
    cfg = read_config()
    cfg["logins"] = [l for l in cfg["logins"] if not (l.get("workspace") == login.get("workspace") and l["api"] == login["api"])] + [login]
    if not cfg.get("default") or len(cfg["logins"]) == 1:
        cfg["default"] = login.get("workspace")
    return save_cfg(cfg)


def load_cfg():
    api = os.environ.get("BH_API")
    key = os.environ.get("BH_KEY")
    if api and key:
        return {"api": api.rstrip("/"), "key": key}
    cfg = read_config()
    if not cfg["logins"]:
        die("not logged in. Run: bh claim <code>   (the code is on your account page)   or: bh login https://api.<platform> <project-key>")
    want = ACTIVE["ws"] or cfg.get("default")
    for l in cfg["logins"]:
        if want is None or l.get("workspace") == want:
            return l
    for l in cfg["logins"]:
        if l.get("workspace") == "*":            # an account key works everywhere the person belongs
            return dict(l, default_ws=want or cfg.get("default"))
    if ACTIVE["ws"]:
        have = ", ".join(l.get("workspace") or "?" for l in cfg["logins"])
        die(f"not logged in to workspace {ACTIVE['ws']} (logged in to: {have}). Sign in at the account page, pick {ACTIVE['ws']}, mint a key, then: bh claim <code>")
    return cfg["logins"][0]


def die(msg, code=1):
    print(f"bh: {msg}", file=sys.stderr)
    sys.exit(code)


def workspace_name(cfg) -> str | None:
    """The workspace a command means, by name: never the account key's '*'."""
    ws = ACTIVE["ws"] or cfg.get("default_ws") or cfg.get("workspace")
    return ws if ws and ws != "*" else None


def auth_headers(cfg) -> dict:
    h = {"Authorization": f"Bearer {cfg['key']}", "User-Agent": "bh/0.3"}
    ws = workspace_name(cfg)
    if ws:
        h["Boathouse-Workspace"] = ws        # an account key is the person; this says which workspace the command means (not X-Boathouse-*: the gateway strips those)
    return h


def call(method, path, body=None, files=None, raw=False, timeout=900):
    cfg = load_cfg()
    url = cfg["api"] + path
    headers = auth_headers(cfg)
    data = None
    if files:
        boundary = uuid.uuid4().hex
        buf = io.BytesIO()
        for k, v in (body or {}).items():
            if v is None:
                continue
            buf.write(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode())
        for k, (fname, content) in files.items():
            buf.write(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"; filename=\"{fname}\"\r\nContent-Type: application/octet-stream\r\n\r\n".encode())
            buf.write(content)
            buf.write(b"\r\n")
        buf.write(f"--{boundary}--\r\n".encode())
        data = buf.getvalue()
        headers["Content-Type"] = f"multipart/form-data; boundary={boundary}"
    elif body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            payload = r.read()
    except urllib.error.HTTPError as e:
        payload = e.read().decode(errors="replace")
        try:
            detail = json.loads(payload).get("detail", payload)
        except ValueError:
            detail = payload
        if isinstance(detail, dict):
            detail = detail.get("error") or json.dumps(detail)
        die(f"{detail}  (HTTP {e.code})")
    except urllib.error.URLError as e:
        die(f"cannot reach {cfg['api']}: {e.reason}")
    if raw:
        return payload.decode(errors="replace")
    return json.loads(payload) if payload else None


def out(obj):
    print(json.dumps(obj, indent=2, ensure_ascii=False))


def ago(ts):
    if not ts:
        return "-"
    d = time.time() - float(ts)
    for unit, s in (("d", 86400), ("h", 3600), ("m", 60)):
        if d >= s:
            return f"{int(d // s)}{unit} ago"
    return "just now"


# ---- packaging -------------------------------------------------------------------

def read_ignore(root: Path):
    pats = []
    f = root / ".dockerignore"
    if f.exists():
        for line in f.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                pats.append(line.rstrip("/"))
    return pats


def pack(root: Path) -> bytes:
    pats = read_ignore(root)

    def skip(rel: str) -> bool:
        parts = rel.split("/")
        if any(p in ALWAYS_EXCLUDE or (p.startswith('.env.') and p not in {'.env.example', '.env.sample', '.env.template'}) for p in parts):
            return True
        return any(fnmatch.fnmatch(rel, p) or fnmatch.fnmatch(parts[-1], p) or rel.startswith(p + "/") for p in pats)

    buf = io.BytesIO()
    count = 0
    with tarfile.open(fileobj=buf, mode="w:gz") as tf:
        for path in sorted(root.rglob("*")):
            rel = path.relative_to(root).as_posix()
            if skip(rel) or path.is_dir():
                continue
            tf.add(path, arcname=rel, recursive=False)
            count += 1
    if not (root / "Dockerfile").exists() and not (root / "index.html").exists():
        die("nothing to deploy here: a tool is a folder with a Dockerfile that listens on $PORT (8080), or a website folder with an index.html at the top")
    return buf.getvalue()


def guess_slug(root: Path) -> str:
    meta = root / "boathouse.json"
    if meta.exists():
        s = json.loads(meta.read_text()).get("slug")
        if s:
            return s
    return re.sub(r"[^a-z0-9-]", "-", root.name.lower()).strip("-")[:31]


