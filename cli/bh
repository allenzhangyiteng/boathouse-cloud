def cmd_signup(a):
    api = (a.api or (load_cfg()["api"] if CONFIG.exists() else "https://api.boathousecloud.com")).rstrip("/")
    req = urllib.request.Request(api + "/api/signup", data=json.dumps({"workspace": a.name, "email": a.email, "code": getattr(a, "code", None)}).encode(),
                                 headers={"Content-Type": "application/json", "User-Agent": "bh/0.3"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            j = json.loads(r.read())
    except urllib.error.HTTPError as e:
        payload = e.read().decode(errors="replace")
        try:
            detail = json.loads(payload).get("detail", payload)
        except ValueError:
            detail = payload
        die(f"{detail}  (HTTP {e.code})")
    if j.get('requires_signup'):
        print(j['note'])
        print(j['signup_url'])
        return
    print(f"workspace {j['workspace']} created." + (" Half price on every tool for 60 days with your referral code." if j.get("referred_by") else ""))
    print(f"tools    {j['home']}")
    if j.get("invite_url"):
        print(f"sign in  {j['invite_url']}   (the owner confirms their email and chooses a password)")
    print(f"account  {j['account']}   (balance, card, project keys, people)")
    plat = urllib.parse.urlparse(j["api"]).netloc.removeprefix("api.")
    print(f"connect  curl -fsSL https://{plat}/install.sh | sh -s -- <code>   (one line: installs bh, logs in, teaches Claude Code; the code is on your account page)")
    print(f"     or  bh login {j['api']} <key>")
    print(f"MCP: {j['mcp']} with header Authorization: Bearer <key>")


def cmd_login(a):
    prior = {k: os.environ.get(k) for k in ("BH_API", "BH_KEY")}
    os.environ["BH_API"], os.environ["BH_KEY"] = a.api.rstrip("/"), a.key
    try:
        me = call("GET", "/api/whoami")
        who = call("GET", "/api/me")
    finally:
        for k, v in prior.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
    if who.get("account_key"):
        cfg = read_config()
        cfg["logins"] = [l for l in cfg["logins"] if l["api"] != a.api.rstrip("/")]     # one account key replaces workspace keys for the same platform
        cfg["logins"].append({"api": a.api.rstrip("/"), "key": a.key, "workspace": "*", "email": me["email"]})
        if getattr(a, "claimed_workspace", None):
            cfg["default"] = a.claimed_workspace
        elif not cfg.get("default") or not any(w["slug"] == cfg["default"] for w in who["workspaces"]):
            cfg["default"] = who["workspaces"][0]["slug"] if who["workspaces"] else None
        where = save_cfg(cfg)
        names = ", ".join(f"{w['slug']} ({w['role']})" for w in who["workspaces"])
        print(f"logged in as {me['email']}. This key is you: it works in {len(who['workspaces'])} workspace{'' if len(who['workspaces']) == 1 else 's'}: {names}. Default: {cfg['default']}."
              + (" Name a tool as <workspace>/<tool> or use --ws to aim elsewhere." if len(who["workspaces"]) > 1 else ""))
        if where != _config_candidates()[0] and not os.environ.get("BH_CONFIG"):
            print(f"(login kept at {where} because ~/.config is not writable on this machine)")
        return
    where = save_login({"api": a.api.rstrip("/"), "key": a.key, "workspace": me["workspace"], "email": me["email"], "domain": me["domain"]})
    print(f"logged in as {me['email']} ({me['role']}) in workspace {me['workspace']}; tools live at *.{me['domain']}")
    cfg = read_config()
    if len(cfg["logins"]) > 1:
        print(f"you are logged in to {len(cfg['logins'])} workspaces ({', '.join(l.get('workspace') or '?' for l in cfg['logins'])}); the default is {cfg['default']}. "
              f"Aim a command elsewhere with bh --ws <workspace> ..., or name a tool as <workspace>/<tool>.")
    if where != _config_candidates()[0] and not os.environ.get("BH_CONFIG"):
        print(f"(login kept at {where} because ~/.config is not writable on this machine)")


def cmd_logout(a):
    cfg = read_config()
    target = a.workspace
    removed = []
    for login in cfg["logins"]:
        matches = target is None or login.get("workspace") == target
        if not matches and login.get("workspace") == "*":
            matches = target == cfg.get("default")
            if not matches:
                request = urllib.request.Request(login["api"] + "/api/me", headers={"Authorization": "Bearer " + login["key"]})
                try:
                    with urllib.request.urlopen(request, timeout=30) as response:
                        matches = target in {w["slug"] for w in json.loads(response.read()).get("workspaces", [])}
                except (urllib.error.URLError, ValueError, TimeoutError):
                    pass
        if matches:
            removed.append(login)
    if not removed:
        die("no matching connection. Run bh logout without a workspace to disconnect all accounts on this machine.")
    cfg["logins"] = [login for login in cfg["logins"] if login not in removed]
    if not cfg["logins"]:
        cfg["default"] = None
    elif cfg.get("default") == target or any(login.get("workspace") == "*" for login in removed):
        cfg["default"] = next((login["workspace"] for login in cfg["logins"] if login.get("workspace") != "*"), None)
    save_cfg(cfg)
    print("Disconnected on this machine." + (" Account connections cover all of that account’s workspaces, so those are disconnected together." if any(login.get("workspace") == "*" for login in removed) else ""))


def cmd_claim(a):
    """Trade a one-time code from the welcome page for the key it stands for, and log in."""
    api = (a.api or "https://api.boathousecloud.com").rstrip("/")
    body = json.dumps({"code": a.code.strip()}).encode()
    req = urllib.request.Request(api + "/api/claim", data=body, headers={"Content-Type": "application/json", "User-Agent": "bh/0.3"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            j = json.loads(r.read())
    except urllib.error.HTTPError as e:
        payload = e.read().decode(errors="replace")
        try:
            detail = json.loads(payload).get("detail", payload)
        except ValueError:
            detail = payload
        die(f"{detail}  (HTTP {e.code})")
    except (urllib.error.URLError, TimeoutError) as e:
        die(f"Could not connect to Boat House: {getattr(e, 'reason', e)}. Check the connection and retry.")
    a.api, a.key = j["api"], j["key"]
    a.claimed_workspace = j.get("workspace")
    ACTIVE["ws"] = a.claimed_workspace
    cmd_login(a)


def cmd_export(a):
    """One archive per tool, saved next to you: the code, the database as SQL, the files under /data."""
    import shutil
    if a.tool and not a.all:
        slugs = [a.tool]
    else:
        slugs = [t["slug"] for t in call("GET", "/api/tools")]
        if not slugs:
            die("no tools in this workspace")
    dest = Path(a.dir or ".").resolve()
    dest.mkdir(parents=True, exist_ok=True)
    cfg = load_cfg()
    stamp = time.strftime("%Y%m%d")
    for slug in slugs:
        out = dest / f"{slug}-{stamp}.tar.gz"
        req = urllib.request.Request(cfg["api"] + f"/api/tools/{slug}/export", headers=auth_headers(cfg))
        try:
            with urllib.request.urlopen(req, timeout=900) as r, open(out, "wb") as f:
                shutil.copyfileobj(r, f)
        except urllib.error.HTTPError as e:
            payload = e.read().decode(errors="replace")
            try:
                detail = json.loads(payload).get("detail", payload)
            except ValueError:
                detail = payload
            die((f"{slug}: " if a.all else "") + f"{detail}  (HTTP {e.code})")
        with tarfile.open(out, "r:gz") as tf:
            names = tf.getnames()
        parts = [p for p in ("source", "database.sql", "data", "README.txt") if any(n == p or n.startswith(p + "/") for n in names)]
        print(f"{slug:<16} {out}  ({out.stat().st_size/1024:.0f} KB: {', '.join(parts)})")
    print("Secrets are not included; the README inside says how to run the tool elsewhere.")


def cmd_restore(a):
    pts = call("GET", f"/api/tools/{a.tool}/restore-points")
    if not pts:
        die(f"no nightly backup holds {a.tool} yet; the first one runs at 03:35 UTC")
    if not a.frm and not a.yes:
        print(f"{'DATE':<12} {'DATABASE':<10} {'FILES':<8}")
        for p in pts:
            kb = lambda n: "%d KB" % max(1, n // 1024)
            print(f"{p['date']:<12} {kb(p['database_bytes']) if p['database'] else '-':<10} {kb(p['files_bytes']) if p['files'] else '-':<8}")
    r = call("POST", f"/api/tools/{a.tool}/restore", body={"date": a.frm, "confirm": bool(a.yes)})
    plan = r["plan"]
    if not r.get("confirm"):
        print(f"\nrestore {a.tool} from {plan['date']}: replaces {plan['replaces']}; {plan['keeps']}; {plan['downtime']}.")
        print(f"Nothing was changed. To do it:  bh restore {a.tool} --from {plan['date']} --yes")
        return
    what = " and ".join(w for w, ok in (("database", r["database"]), ("files", r["files"])) if ok) or "nothing"
    print(f"restored {a.tool} from {plan['date']}: {what} put back; the tool is running again.")
    print(f"what it held before is kept at {r['snapshot']} on the box.")


def cmd_mail(a):
    if a.action == "status":
        r = call("GET", "/api/mail")
        if r["configured"] and not r.get("from"):
            print("email: on. bh share and bh users add email people their link and steps; you also get the link to pass on.")
        elif r["configured"]:
            print(f"email: on, sent as {r['from']} via {'Resend (HTTPS)' if r.get('provider') == 'resend' else r['host']}")
        else:
            print("email: not set up. Shares print a link to send by hand. Turn it on over HTTPS: BH_MAIL_KEY=... bh mail set --resend --from you@yourdomain, "
                  "then bh mail domain. (SMTP also works where the host allows it: BH_SMTP_PASSWORD=... bh mail set --host smtp.gmail.com --user you@yourdomain)")
    elif a.action == "set":
        if a.resend:
            key = os.environ.get("BH_MAIL_KEY") or ""
            if not key:
                die("put the Resend API key in the environment first: BH_MAIL_KEY=... bh mail set --resend --from you@yourdomain   (never on the command line)")
            if not a.sender or "@" not in a.sender:
                die("usage: bh mail set --resend --from you@yourdomain")
            call("PUT", "/api/mail", body={"provider": "resend", "api_key": key, "from": a.sender})
            print(f"email on: sent as {a.sender} over HTTPS through Resend. Next: bh mail domain (verifies {a.sender.split('@')[-1]} as a sender), then bh mail test")
            return
        pw = os.environ.get("BH_SMTP_PASSWORD") or ""
        if not pw:
            die("put the mailbox app password in the environment first: BH_SMTP_PASSWORD=... bh mail set --host ... --user ...   (never on the command line)")
        if not a.host or not a.user:
            die("usage: bh mail set --host smtp.gmail.com [--port 587] --user you@yourdomain [--from you@yourdomain]")
        r = call("PUT", "/api/mail", body={"host": a.host, "port": a.port or 587, "user": a.user, "password": pw, "from": a.sender or a.user})
        print(f"email on: sent as {a.sender or a.user} via {r['host']}. Try it: bh mail test")
    elif a.action == "domain":
        r = call("POST", "/api/mail/domain")
        for rec in r["records"]:
            print(f"  {rec['type']:<5} {rec['name']:<40} {rec['content'][:60]}")
        status = r["status"]
        waited = 0
        while status != "verified" and waited < 90:
            time.sleep(10); waited += 10
            status = call("GET", "/api/mail/domain")["status"]
        if status == "verified":
            print(f"{r['domain']} is a verified sender. Try it: bh mail test")
        else:
            print(f"{r['domain']}: records written, Resend still checking ({status}). DNS can take a few minutes; run bh mail domain again.")
    elif a.action == "test":
        r = call("POST", "/api/mail/test")
        print(f"sent a test email to {r['sent_to']}")


