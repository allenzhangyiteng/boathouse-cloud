def _dollars(x):
    try:
        cents = Decimal(str(x).lstrip("$")) * 100
        if not cents.is_finite() or cents != cents.to_integral_value():
            raise ValueError()
        return int(cents)
    except (InvalidOperation, ValueError):
        die("give an amount in dollars with at most two decimal places, like 20 or 12.50")


