# Replace the example domain, IP and owner address with values you control.
BH_DOMAIN=tools.example.com
BH_PUBLIC_IP=203.0.113.10
BH_ACME_EMAIL=owner@example.com
BH_WORKSPACE=starter
BH_WORKSPACE_NAME=Starter
BH_HOST_WORKSPACE=starter
BH_OWNERS=owner@example.com
# Generate this locally: openssl rand -hex 32
BH_PG_PASSWORD=
BH_STATE_HOST=/var/lib/boathouse/state
# Self-hosting does not require payments to Boat House. Disable usage metering.
BH_METER=0
